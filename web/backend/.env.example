# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-secret-key-here

# ── Production only (set DJANGO_ENV=production) ──────────────────────────────
# DJANGO_ALLOWED_HOSTS=deepstoa.com,www.deepstoa.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://deepstoa.com,https://www.deepstoa.com
# CORS_ALLOWED_ORIGINS=https://deepstoa.com,https://www.deepstoa.com
# DATABASE_URL=postgres://user:password@host:5432/deepstoa

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
