# debug/t_quality/sdkconfig.defaults
# Note: PSRAM is DISABLED — the display buffer (~19KB) fits in internal SRAM (512KB).

# Target: ESP32-S3
CONFIG_IDF_TARGET_ESP32S3=y

# Main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Task watchdog timeout (a full e-ink refresh can take several seconds)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# FatFS: enable LFN (required by hardcoded FF_FS_EXFAT=1 in ffconf.h)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_LABEL=y
