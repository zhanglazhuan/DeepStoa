# debug/t_lvgl/sdkconfig.defaults
# Minimal LVGL test — no PSRAM needed (single 48KB buffer fits in internal SRAM)
CONFIG_IDF_TARGET_ESP32S3=y

# DeepStoa v1 has 16 MB flash and uses the native USB console.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# FatFS defaults (for compatibility)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_LABEL=y

# LVGL memory — only needed for the test rectangle
CONFIG_LV_MEM_SIZE_KILOBYTES=64

# LVGL widgets needed for tabview test
CONFIG_LV_USE_TABVIEW=y
CONFIG_LV_USE_BUTTONMATRIX=y

# Fonts needed by lv_theme_hardcore
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
