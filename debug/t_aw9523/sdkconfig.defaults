# debug/t_aw9523/sdkconfig.defaults
# Target: ESP32-S3 (DeepStoa v1 board)
CONFIG_IDF_TARGET_ESP32S3=y

# Board has a 16 MB flash chip.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Use the ESP32-S3 native USB Serial/JTAG console (COM11).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Set main task stack size to 8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase task watchdog timeout (max 60 for ESP32S3)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# FatFS: enable LFN (required by hardcoded FF_FS_EXFAT=1 in ffconf.h)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_LABEL=y
