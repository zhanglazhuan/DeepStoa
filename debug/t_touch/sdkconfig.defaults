# debug/t_touch/sdkconfig.defaults
# Touch controller test

# Target
CONFIG_IDF_TARGET_ESP32S3=y

# FATFS: must enable LFN (ESP-IDF v5.5 hardcodes FF_FS_EXFAT=1 which requires LFN)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_LABEL=y

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
